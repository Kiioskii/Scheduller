# Puste = proxy Vite (/api, /socket.io) w dev
VITE_API_URL=
VITE_SOCKET_URL=

# Supabase Auth (klucz anon/public z dashboardu projektu)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Bezpośrednio na backend (bez proxy Vite) — backend musi mieć prefiks /api:
# VITE_API_URL=http://localhost:3000
# VITE_SOCKET_URL=http://localhost:3000
